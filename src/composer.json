{
    "name": "xavante/worker",
    "description": "Worker for Xavante project - Laravel Zero Application",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Eduardo Luz",
            "email": "xavante@eduardo-luz.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "/app/lib/core"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel-zero/framework": "^11.0",
        "guzzlehttp/guzzle": "^7.10",
        "xavante/core": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "bin": ["worker"]
}
