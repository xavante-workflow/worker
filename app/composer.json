{
    "name": "xavante/worker",
    "description": "Worker for Xavante project",
    "type": "application",
    "license": "MIT",
    "authors": [
        {
            "name": "Eduardo Luz",
            "email": "xavante@eduardo-luz.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../../lib/core"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^7.10",
        "xavante/core": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Xavante\\Worker\\": "src/",
            "Tests\\": "tests/"
        }
    }
}
